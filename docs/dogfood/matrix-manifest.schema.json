{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentcanvas.local/schemas/dogfood-matrix-manifest.v1.json",
  "title": "AgentCanvas dogfood matrix manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "agents", "workspaces", "runs"],
  "properties": {
    "schema": {
      "const": "agentcanvas.dogfood_matrix.v1"
    },
    "agents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "public_claim"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "public_claim": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "workspaces": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "gate"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "type": {
            "enum": ["agentcanvas", "nextjs", "fastapi", "laravel", "monorepo", "other"]
          },
          "gate": { "type": "boolean" },
          "notes": { "type": "string" }
        }
      }
    },
    "runs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "agent_id",
          "workspace_id",
          "attempt",
          "status",
          "loop",
          "runbook_id",
          "permission_prompt_count",
          "triage_class"
        ],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "workspace_id": { "type": "string", "minLength": 1 },
          "attempt": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["clean", "failed", "blocked", "launch_note", "post_launch"] },
          "loop": { "enum": ["interim_narrow", "full_loop"] },
          "runbook_id": { "type": "string", "minLength": 1 },
          "permission_prompt_count": { "type": "integer", "minimum": 0 },
          "triage_class": { "enum": ["none", "a", "b", "c"] },
          "proof_manifest_path": { "type": "string" },
          "issue_url": { "type": "string" },
          "recording": {
            "type": "object",
            "additionalProperties": false,
            "required": ["redacted"],
            "properties": {
              "raw_path": { "type": "string" },
              "public_path": { "type": "string" },
              "redacted": { "type": "boolean" },
              "notes": { "type": "string" }
            }
          },
          "notes": { "type": "string" }
        }
      }
    }
  }
}
